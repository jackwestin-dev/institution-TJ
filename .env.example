# Local alternative to .streamlit/secrets.toml. Copy to .env and fill in.
# sync_reports.py reads these; the Streamlit views fall back to them when no
# secrets.toml is present.

# Canvas instance URL, no trailing slash
CANVAS_URL=https://texasjamp.instructure.com

# Canvas -> Account -> Settings -> New Access Token. Needs Teacher access.
CANVAS_TOKEN=your_api_token_here

# Optional essay-review backends
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
