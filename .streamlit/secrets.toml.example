# Copy to .streamlit/secrets.toml for local runs (it is gitignored), or paste
# the same keys into Settings -> Secrets in the Streamlit Community Cloud UI.
#
# Every key is optional. Anything left out just means the matching sidebar field
# starts empty and you type the value in by hand.

# Gates the whole dashboard. If this key is absent the app opens with NO
# password — set it before deploying anywhere reachable.
password = "choose-a-password"

# Canvas Accuracy -> Quiz Reports
CANVAS_URL = "https://texasjamp.instructure.com"
CANVAS_TOKEN = "your_canvas_api_token"

# Essay Review, only for the non-default backends
GEMINI_API_KEY = ""
ANTHROPIC_API_KEY = ""
