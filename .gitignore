# macOS
.DS_Store

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Env and secrets
.env
.env.local
*.pem
.streamlit/secrets.toml

# Student-identifying Canvas data — NEVER commit these.
#
# reports_cache/ holds Canvas "Student Analysis" exports: full names plus every
# per-question answer. exam_data/ holds MCAT score exports, also named. The
# deployed app reads data/canvas_metrics.csv instead, which is counts only and
# is regenerated by build_canvas_metrics.py.
#
# Committing either would put student names in git history permanently, which no
# later commit can remove.
reports_cache/
exam_data/
*.zip

# De-identification map for the committed data bundle: student_id -> real name.
# The bundle itself carries only opaque IDs and is safe to publish; this file is
# the one thing that could reverse it, so it stays local.
data/.student_map.csv

# Presentation deck and its generator, kept deliberately local. Nothing here is
# student-identifying — the deck is cohort-level and was checked — they are just
# not wanted in the repo. Listed so a stray `git add -A` can't sweep them in.
# To commit one anyway: git add -f <path>
*.pptx
build_slides.py
slide_assets/

# Dependencies (uncomment if you add Node/Python/etc.)
# node_modules/
__pycache__/
# venv/
# .venv/
